{
  "version": 1,
  "protocolVersion": 1,
  "providerUpserts": {
    "systemd-credential-file": {
      "source": "file",
      "path": "/run/credentials/openclaw.service/openclaw-secrets.json",
      "mode": "json",
      "timeoutMs": 5000
    }
  },
  "targets": [
    {
      "type": "models.providers.apiKey",
      "path": "models.providers.openai-codex.apiKey",
      "providerId": "openai-codex",
      "ref": {
        "source": "file",
        "provider": "systemd-credential-file",
        "id": "/providers/openaiCodex/apiKey"
      }
    },
    {
      "type": "channels.discord.token",
      "path": "channels.discord.token",
      "ref": {
        "source": "file",
        "provider": "systemd-credential-file",
        "id": "/channels/discord/token"
      }
    },
    {
      "type": "auth-profiles.api_key.key",
      "path": "profiles.ollama:default.key",
      "agentId": "main",
      "ref": {
        "source": "file",
        "provider": "systemd-credential-file",
        "id": "/authProfiles/ollamaDefault/key"
      }
    },
    {
      "type": "auth-profiles.api_key.key",
      "path": "profiles.openai:ccnode-codex.key",
      "agentId": "main",
      "ref": {
        "source": "file",
        "provider": "systemd-credential-file",
        "id": "/authProfiles/openaiCcnodeCodex/key"
      }
    }
  ]
}
