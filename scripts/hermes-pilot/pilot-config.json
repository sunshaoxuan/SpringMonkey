{
  "_config_version": 53,
  "model": {
    "provider": "custom",
    "default": "gpt-6.1-sol",
    "base_url": "https://ccnode.briconbric.com:49530/v1",
    "api_key": "${HERMES_GATEWAY_API_KEY}",
    "api_mode": "chat_completions",
    "context_length": 64000
  },
  "fallback_providers": [
    {
      "provider": "custom",
      "model": "deepseek-flash",
      "base_url": "https://api.deepseek.com",
      "key_env": "HERMES_DEEPSEEK_API_KEY",
      "api_mode": "chat_completions"
    },
    {
      "provider": "custom",
      "model": "hf.co/unsloth/Qwen3.8-27B-GGUF:UD-IQ3_S",
      "base_url": "https://ccnode.briconbric.com:49530/v1",
      "key_env": "HERMES_GATEWAY_API_KEY",
      "api_mode": "chat_completions"
    }
  ],
  "providers": {
    "springmonkey-deepseek": {
      "base_url": "https://api.deepseek.com",
      "key_env": "HERMES_DEEPSEEK_API_KEY",
      "api_mode": "chat_completions",
      "default_model": "deepseek-flash",
      "models": ["deepseek-flash"]
    }
  },
  "moa": {
    "default_preset": "default",
    "active_preset": "",
    "save_traces": false,
    "privacy_filter": "full",
    "presets": {
      "default": {
        "enabled": true,
        "reference_models": [
          {"provider": "custom:springmonkey-deepseek", "model": "deepseek-flash"},
          {"provider": "custom", "model": "hf.co/unsloth/Qwen3.8-27B-GGUF:UD-IQ3_S"}
        ],
        "aggregator": {"provider": "custom", "model": "gpt-6.1-sol"},
        "fanout": "user_turn",
        "reference_timeout": 180,
        "degraded_reference_policy": "loud"
      }
    }
  },
  "toolsets": ["terminal", "file", "web", "browser", "skills", "memory", "computer_use", "cronjob"],
  "max_concurrent_sessions": 2,
  "max_live_sessions": 1,
  "agent": {"max_turns": 100, "api_max_retries": 2, "auto_recovery_cycles": 1, "run_budget_seconds": 7200},
  "terminal": {"backend": "local", "cwd": "/workspace", "timeout": 120},
  "web": {"backend": "exa", "search_backend": "exa", "extract_backend": "exa", "keyless_fallback": true},
  "browser": {"cloud_provider": "local", "engine": "auto", "headed": true, "use_real_profile": false, "user_data_dir": "", "inactivity_timeout": 1800, "command_timeout": 60},
  "bot_desktop": {"geometry": "1440x900", "auto_start": true, "min_free_memory_mb": 1536, "idle_stop_minutes": 30, "placement": "auto"},
  "webapp": {"enabled": true, "host": "127.0.0.1", "port": 9120, "public_url": "https://sm.briconbric.com/app"},
  "auxiliary": {"title_generation": {"enabled": false}, "background_review": {"enabled": false}},
  "skills": {"project_discovery": false, "guard_agent_created": true, "write_approval": true, "inline_shell": false},
  "security": {"allow_private_urls": false, "redact_secrets": true, "protected_instruction_files": true, "allow_lazy_installs": false},
  "approvals": {"mode": "smart", "single_query_mode": "deny", "unattended_mode": "deny", "cron_mode": "deny"},
  "updates": {"check": false},
  "cron": {"allow_agent_scheduling": true},
  "hooks_auto_accept": false,
  "timezone": "Asia/Tokyo"
}
